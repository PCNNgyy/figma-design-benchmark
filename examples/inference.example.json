{
  "claude_bin": "claude",
  "node_bin": "node",
  "timeout_seconds": 5400,
  "check_timeout_seconds": 600,
  "concurrency": 10,
  "models": [
    {
      "id": "model-a",
      "cli_model": "claude-opus-5-5",
      "base_url": "https://gateway.example.invalid",
      "api_key_env": "MODEL_API_KEY",
      "effort": "low",
      "max_output_tokens": 16384
    }
  ],
  "accounts": [
    {
      "id": "account-a",
      "identity": "account-a@example.invalid",
      "auth_file": "../private/figma-account-a.json"
    }
  ],
  "jobs": [
    {
      "id": "example-task-model-a",
      "model_id": "model-a",
      "account_id": "account-a",
      "figma_url": "https://www.figma.com/design/replaceWithAssignedCopy/",
      "query_file": "task-query.txt",
      "expected_screens": 2,
      "required_screen_names": [
        "01_Catalog",
        "02_Detail"
      ]
    }
  ]
}
